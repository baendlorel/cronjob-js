{
  "name": "crontab-js",
  "version": "0.0.1",
  "description": "A minimal crontab for JavaScript and TypeScript: write a 5-field cron expression in a script's header comment, and the script is spawned when it matches. Complete TypeScript types included.",
  "description_zh": "极简的 JS 版 crontab：把 5 段 cron 写在脚本头部注释里，到点就运行；完整 TS 类型支持。",
  "type": "module",
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/baendlorel/cronjob-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baendlorel/cronjob-js.git"
  },
  "bugs": {
    "url": "https://github.com/baendlorel/cronjob-js/issues"
  },
  "keywords": [
    "crontab",
    "cron",
    "scheduler",
    "job",
    "typescript",
    "javascript",
    "timezone"
  ],
  "scripts": {
    "build": "tsdown",
    "buildtsc": "tsc -p tsconfig.build.json",
    "pub": "pnpm run build && tsx ./scripts/index.ts --publish",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cron-parser": "^5.10.6"
  }
}